# Copy to .env.local for local development. On Vercel, set these under
# Project Settings → Environment Variables instead. Never commit real values.

# Password for /admin. Use a long, unique one.
ADMIN_PASSWORD=

# bunny.net. Leave all of these empty locally to keep uploads on disk in .cms/.
# Bunny Stream (videos): from the video library's API page.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST=
# Bunny Storage (images and the content list).
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# storage.bunnycdn.com for Falkenstein/Frankfurt; otherwise the region's host,
# e.g. sg.storage.bunnycdn.com
BUNNY_STORAGE_HOST=
BUNNY_STORAGE_CDN_HOST=
